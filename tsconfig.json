{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": false, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "jsx": "react-jsx", "jsxImportSource": "preact", "types": ["node", "vite/client"],
    "isolatedModules": true, "verbatimModuleSyntax": false
  },
  "include": ["src", "tests", "tools"]
}
